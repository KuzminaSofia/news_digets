# --- LLM (OpenRouter is the default adapter) ---
OPENROUTER_API_KEY=sk-or-...
# Optional attribution headers for OpenRouter rankings:
OPENROUTER_REFERER=https://github.com/your/repo
OPENROUTER_TITLE=Digest Engine

# --- Telegram delivery ---
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_CHAT_ID=-1001234567890

# --- RSSHub (self-hosted) ---
# Usually you don't need to set this: docker-compose injects
# RSSHUB_BASE_URL=http://rsshub:1200 into the digest container automatically,
# and the configs fall back to http://localhost:1200 outside Docker.
# Override only if RSSHub runs elsewhere.
# RSSHUB_BASE_URL=http://rsshub:1200
