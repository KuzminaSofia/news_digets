# Keep the build context (and image) small and reproducible.

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# Secrets & local env (never bake into the image)
.env
*.local

# Runtime output (mounted as volumes at run time)
digests/
state/
*.log

# Tooling / caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.DS_Store

# VCS & CI
.git/
.github/

# Tests are not needed in the runtime image
tests/
